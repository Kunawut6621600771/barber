# คัดลอกไฟล์นี้เป็น .env แล้วแก้ค่าให้ตรงกับเครื่องคุณ
PORT=5050
NODE_ENV=development

# PostgreSQL
# ฐานข้อมูลบนคลาวด์ (เช่น Neon) ใส่ connection string บรรทัดเดียว แล้วไม่ต้องใช้ PGHOST..PGDATABASE
# DATABASE_URL=postgresql://user:pass@ep-xxxx-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=verify-full
PGHOST=localhost
PGPORT=5440
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=barbershop

# JWT
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=8h
REFRESH_EXPIRES_DAYS=7

# ที่อยู่ frontend (สำหรับ CORS และลิงก์ในอีเมลรีเซ็ตรหัสผ่าน)
CLIENT_URL=http://localhost:3000

# เขตเวลาของร้าน — ใช้กำหนดว่า "คิวของวันนี้" หมายถึงวันไหน
# ตั้งค่านี้ให้ตรงกับเขตเวลาจริงของร้านเสมอ แม้เซิร์ฟเวอร์ฐานข้อมูลจะรันเป็น UTC
SHOP_TIMEZONE=Asia/Bangkok

# ที่อยู่ https สาธารณะของเว็บ (เช่น https://xxxx.ngrok-free.app) ใช้ทำลิงก์ใน LINE / QR
# ถ้าเปิดผ่าน tunnel ให้ใส่ URL เดียวกันนี้ใน CLIENT_URL ด้วย (คั่นด้วย , ได้หลายค่า)
PUBLIC_URL=

# ---------------------------------------------------------------------
# ชำระเงินด้วย QR PromptPay (จ่ายตอนรับบัตรคิว)
# ---------------------------------------------------------------------
# เบอร์มือถือ 10 หลัก หรือเลขบัตรประชาชน/เลขผู้เสียภาษี 13 หลัก ที่ผูกพร้อมเพย์ของร้าน
PROMPTPAY_ID=
PROMPTPAY_NAME=Trim & Co.
# true = ลูกค้าต้องจ่ายก่อนจึงได้บัตรคิว (พนักงานออกบัตร walk-in ได้ตามปกติ)
PAYMENT_REQUIRED=true
# QR หมดอายุภายในกี่นาที
PAYMENT_EXPIRE_MIN=15

# ตรวจสลิปอัตโนมัติ: easyslip = ใช้ EasySlip API จริง | mock = โหมดทดสอบ (ถือว่าสลิปถูกต้องเสมอ ห้ามใช้จริง)
SLIP_PROVIDER=mock
EASYSLIP_API_KEY=
EASYSLIP_API_URL=https://api.easyslip.com/v2/verify/bank
# เทียบเลขพร้อมเพย์ผู้รับบนสลิปกับ PROMPTPAY_ID
SLIP_CHECK_RECEIVER=true

# ---------------------------------------------------------------------
# LINE Official Account (Messaging API) + LIFF  — ดูวิธีตั้งค่าใน docs/LINE_PROMPTPAY_SETUP.md
# ---------------------------------------------------------------------
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=
# รหัสบัญชีทางการ เช่น @123abcde — จำเป็นสำหรับ QR ผูกบัญชีหน้าชำระเงิน
LINE_BOT_BASIC_ID=
LINE_LOGIN_CHANNEL_ID=
LIFF_ID=
